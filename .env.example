# Copy to .env (never commit it). Read by the gateway and the app in compose.yaml.

# The gateway's own key; the app sends it as LITELLM_API_KEY.
LITELLM_MASTER_KEY=sk-change-me
LITELLM_API_KEY=sk-change-me

# Provider keys: only the gateway sees them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# The provider model behind each alias in harness.yaml (LiteLLM model names).
HARNESSWEAVER_UPSTREAM_RAG_CHAT=anthropic/claude-sonnet-5-5
HARNESSWEAVER_UPSTREAM_RAG_EMBED=openai/text-embedding-3-small
HARNESSWEAVER_UPSTREAM_RAG_RERANK=cohere/rerank-v3.5

# Vector stores.
QDRANT_API_KEY=
DATABASE_URL=postgresql://rag:rag@postgres:5432/rag

# Optional: what the API says when the knowledge base has no answer.
# RAG_NOT_FOUND_MESSAGE=I couldn't find that in the knowledge base.
